PORT=3000
NODE_ENV=development
# Kailangan sa production (24+ characters). Gumawa: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret
# Gawing admin ang account na may ganitong email (kapag nag-register o nag-restart ang server)
ADMIN_EMAIL=

# DATABASE
# Lokal (development): iwanang blangko ang dalawa sa ibaba; gagamit ng data/nova.sqlite.
# Online (Render, atbp.): libreng Turso database para hindi mawala ang data. Tingnan ang README.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Opsyonal: SMS sa customer kapag Handa na / Kanselado ang order, at kapag may stock na ulit (Semaphore PH)
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER=
